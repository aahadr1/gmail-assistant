# Template only — DO NOT put real secrets in this file.
# For local dev, create .env.local (and optionally .env for Prisma CLI).

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NextAuth
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Database (Supabase Postgres URI)
DATABASE_URL=

# Token encryption (base64 32 bytes; generate with: openssl rand -base64 32)
TOKEN_ENCRYPTION_KEY=
